{
    "name": "omeka/omeka-s",
    "type": "project",
    "description": "The Omeka S collections management system. A local network of independently curated exhibits sharing a collaboratively built pool of items and their metadata.",
    "license": "GPL-3.0",
    "require": {
        "php": "^8.3",
        "ext-fileinfo": "*",
        "ext-mbstring": "*",
        "ext-pdo_mysql": "*",
        "ext-xml": "*",
        "doctrine/orm": "^2.11.2|^3.0",
        "doctrine/cache": "^1.12.1|^2.0",
        "doctrine/dbal": "^2.13.8|^3.0|^4.0",
        "sweetrdf/easyrdf": "^1.0",
        "ml/json-ld": "^1.1",
        "ezyang/htmlpurifier": "^4.8",
        "composer/semver": "^3.2",
        "laminas/laminas-zendframework-bridge": "^1.0",
        "laminas/laminas-authentication": "^2.5.3",
        "laminas/laminas-config": "^3.7.0",
        "laminas/laminas-dom": "^2.6",
        "laminas/laminas-eventmanager": "^3.0.1",
        "laminas/laminas-filter": "^2.7.1|^3.0",
        "laminas/laminas-form": "^3.1.1",
        "laminas/laminas-http": "^2.5.4",
        "laminas/laminas-i18n": "^2.7.3",
        "laminas/laminas-i18n-resources": "^2.5.2",
        "laminas/laminas-inputfilter": "^2.7.2",
        "laminas/laminas-json": "^3.0",
        "laminas/laminas-math": "^3.0",
        "laminas/laminas-modulemanager": "^2.11.0",
        "laminas/laminas-mvc": "^3.0.1",
        "laminas/laminas-mvc-i18n": "^1.0",
        "laminas/laminas-navigation": "^2.8.1",
        "laminas/laminas-permissions-acl": "^2.6",
        "laminas/laminas-router": "^3.9",
        "laminas/laminas-servicemanager": "^3.1|^4.0",
        "laminas/laminas-session": "^2.7.1",
        "laminas/laminas-stdlib": "^3.0.1",
        "laminas/laminas-uri": "^2.5.2",
        "laminas/laminas-validator": "^2.8|^3.0",
        "laminas/laminas-view": "^2.8",
        "omeka/composer-addon-installer": "*",
        "omeka-s-themes/default": "dev-develop",
        "beberlei/doctrineextensions": "^1.0",
        "fileeye/pel": "^0.12.0",
        "symfony/flex": "^2.10",
        "symfony/skeleton": "^6.4||^7.4||^8.0",
        "symfony/runtime": "*",
        "symfony/yaml": "*",
        "symfony/dotenv": "^7.4",
        "symfony/asset": "^7.4",
        "symfony/asset-mapper": "^7.4",
        "symfony/doctrine-messenger": "^7.2",
        "symfony/expression-language": "^7.4",
        "symfony/form": "^7.2",
        "symfony/http-client": "^7.4",
        "symfony/intl": "^7.0",
        "symfony/mailer": "^7.4",
        "symfony/mime": "^7.4",
        "symfony/monolog-bundle": "^3.0|^4.0",
        "symfony/notifier": "^7.4",
        "doctrine/doctrine-bundle": "^2.18",
        "doctrine/doctrine-migrations-bundle": "^3.7",
        "symfony/process": "^6.4",
        "symfony/security-bundle": "^7.2",
        "phpdocumentor/reflection-docblock": "^5.6",
        "phpstan/phpdoc-parser": "^2.3",
        "symfony/property-access": "^7.4",
        "symfony/property-info": "^7.4",
        "symfony/serializer": "^7.4",
        "symfony/stimulus-bundle": "^2.32",
        "symfony/string": "^6.0|^7.4",
        "symfony/translation": "^7.4",
        "symfony/twig-bundle": "^7.2",
        "twig/extra-bundle": "^2.12|^3.0",
        "twig/twig": "^2.12|^3.0",
        "symfony/ux-turbo": "^2.32",
        "symfony/validator": "^7.4",
        "symfony/web-link": "^7.4",
        "monolog/monolog": "^2.11",
        "knplabs/knp-menu-bundle": "^3.7",
        "symfony/console": "^7.2",
        "nette/php-generator": "^4.2",
        "nikic/php-parser": "^5.7",
        "laminas/laminas-mvc-plugins": "^1.2",
        "symfony/ux-icons": "^2.32",
        "symfony/ux-twig-component": "^2.32"
    },
    "require-dev": {
        "phpunit/phpunit": "^9",
        "friendsofphp/php-cs-fixer": "^3.8.0",
        "symfony/debug-bundle": "^7.2",
        "symfony/stopwatch": "^6.4",
        "symfony/web-profiler-bundle": "^7.2",
        "symfony/browser-kit": "^7.4",
        "symfony/css-selector": "^6.4",
        "symfony/phpunit-bridge": "^8.0",
        "doctrine/doctrine-fixtures-bundle": "^4.3",
        "symfony/maker-bundle": "^1.65"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src",
            "Omeka\\": "application/src"
        }
    },
    "config": {
        "allow-plugins": {
            "omeka/composer-addon-installer": true,
            "symfony/flex": true,
            "symfony/runtime": true
        }
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/zerocrates/extract-tagged-strings.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/omeka-s-themes/default.git"
        },
        {
            "type": "path",
            "url": "application/data/composer-addon-installer"
        },
        {
            "type": "vcs",
            "url": "https://github.com/omeka/laminas-log"
        }
    ],
    "extra": {
        "symfony": {
            "allow-contrib": "true"
        }
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd",
            "importmap:install": "symfony-cmd"
        }
    }
}
