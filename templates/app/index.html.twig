{% extends 'base.html.twig' %}

{% block title %}{{ installationTitle }}{% endblock %}

{% block body %}
<div class="landing">
    <h1>{{ installationTitle }}</h1>

    <form method="get" action="{{ path('app_root') }}" class="search-form">
        <input type="text" name="fulltext_search" value="{{ searchQuery }}" placeholder="Search sites..." aria-label="Search sites">
        <button type="submit">Search</button>
    </form>

    <h2>Sites</h2>

    {% if sites is empty %}
        <p>No sites found.</p>
    {% else %}
        <div class="sites-list">
            {% for site in sites %}
                <div class="site-summary">
                    <h3><a href="{{ path('app_site_show', {siteSlug: site.slug()}) }}">{{ site.title() }}</a></h3>
                    {% if site.summary() %}
                        <p>{{ site.summary() }}</p>
                    {% endif %}
                </div>
            {% endfor %}
        </div>

        {% if totalResults > sites|length %}
            <nav class="pagination">
                <span>{{ totalResults }} sites total</span>
            </nav>
        {% else %}
            <p class="count">{{ totalResults }} site{{ totalResults != 1 ? 's' : '' }}</p>
        {% endif %}
    {% endif %}

    <p class="admin-link">Go to the <a href="{{ path('app_admin') }}">Admin dashboard</a> to start working with {{ installationTitle }}.</p>
</div>
{% endblock %}
