{% extends 'base.html.twig' %}

{% block title %}Omeka Sites{% endblock %}

{% block body %}
<div>
    <h1><a href="{{ laminas_url('top') }}">Omeka S</a></h1>

    {% if sites is empty %}
        <p>No sites found.</p>
    {% else %}
        <h2>Sites</h2>
        <ul>
            {% for site in sites %}
                <li>
                    <a href="{{ laminas_url('site', {'site-slug': site.slug}) }}">{{ site.title }}</a>
                    ({{ site.slug }})
                </li>
            {% endfor %}
        </ul>
    {% endif %}

    <p>
        <a href="{{ path('app_admin') }}">Admin dashboard (Symfony)</a>
        | <a href="{{ laminas_url('admin') }}">Admin dashboard (Legacy)</a>
    </p>

    <h2>Laminas Routes</h2>
    <table>
        <thead>
            <tr>
                <th>Name</th>
                <th>Route</th>
                <th>Type</th>
                <th>Defaults</th>
                <th>Constraints</th>
            </tr>
        </thead>
        <tbody>
            {% for route in laminas_route_table() %}
                <tr>
                    <td>{{ route.name }}</td>
                    <td>{{ route.route }}</td>
                    <td>{{ route.type }}</td>
                    <td>{{ route.defaults|json_encode }}</td>
                    <td>{{ route.constraints|json_encode }}</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
