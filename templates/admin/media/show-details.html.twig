{# Sidebar details view - no layout wrapper #}
<div class="meta-group">
    <h4>{{ media.displayTitle() }}</h4>
</div>

<div class="meta-group">
    <h4>{{ 'Class'|trans }}</h4>
    <div class="value">{{ media.resourceClass() ? media.resourceClass().label() : 'None'|trans }}</div>
</div>

<div class="meta-group">
    <h4>{{ 'Owner'|trans }}</h4>
    <div class="value">{{ media.owner() ? media.owner().name() : 'None'|trans }}</div>
</div>

<div class="meta-group">
    <h4>{{ 'Visibility'|trans }}</h4>
    <div class="value">
        {% if media.isPublic() %}
            {{ 'Public'|trans }}
        {% else %}
            {{ ux_icon('mdi:lock-outline') }} {{ 'Private'|trans }}
        {% endif %}
    </div>
</div>

<div class="meta-group">
    <h4>{{ 'Ingester'|trans }}</h4>
    <div class="value">{{ media.ingester() }}</div>
</div>

<div class="meta-group">
    <h4>{{ 'Media type'|trans }}</h4>
    <div class="value">{{ media.mediaType() ?: 'None'|trans }}</div>
</div>

{% set item = media.item() %}
{% if item %}
<div class="meta-group">
    <h4>{{ 'Item'|trans }}</h4>
    <div class="value">
        <a href="{{ path('app_admin_item_show', {itemId: item.id()}) }}">{{ item.displayTitle() }}</a>
    </div>
</div>
{% endif %}

<div class="meta-group">
    <h4>{{ 'Created'|trans }}</h4>
    <div class="value">{{ media.created() ? media.created().format('M j, Y') : '' }}</div>
</div>

<div class="meta-group">
    <h4>{{ 'Modified'|trans }}</h4>
    <div class="value">{{ media.modified() ? media.modified().format('M j, Y') : '' }}</div>
</div>

{% set values = media.values() %}
{% if values is not empty %}
<div class="meta-group">
    <h4>{{ 'Values'|trans }}</h4>
    {% for term, info in values %}
        <div class="property">
            <h4>{{ info.property.label() }}</h4>
            {% for value in info.values %}
                <div class="value">{{ value.asHtml()|raw }}</div>
            {% endfor %}
        </div>
    {% endfor %}
</div>
{% endif %}
