{% extends 'admin/base.html.twig' %}

{% block title %}{{ 'Properties'|trans }}: {{ vocabulary.label() }}{% endblock %}

{% block admin_body %}
    <h1>{{ 'Properties'|trans }}: {{ vocabulary.label() }}</h1>

    <p><a href="{{ path('app_admin_vocabulary_show', {id: vocabulary.id()}) }}">&larr; {{ 'Back to vocabulary'|trans }}</a></p>

    {% if properties is empty %}
        <p>{{ 'No properties.'|trans }}</p>
    {% else %}
        <table>
            <thead>
                <tr>
                    <th>{{ 'Label'|trans }}</th>
                    <th>{{ 'Term'|trans }}</th>
                    <th>{{ 'Comment'|trans }}</th>
                </tr>
            </thead>
            <tbody>
                {% for property in properties %}
                    <tr>
                        <td>{{ property.label() }}</td>
                        <td>{{ vocabulary.prefix() }}:{{ property.localName() }}</td>
                        <td>{{ property.comment() }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}
{% endblock %}
