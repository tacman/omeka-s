{% extends 'admin/base.html.twig' %}

{% block title %}{{ 'Admin dashboard'|trans }}{% endblock %}

{% block admin_body %}
    <h1>{{ 'Admin dashboard'|trans }}</h1>

    <div class="panel">
        <h2>{{ 'Manage resources'|trans }}</h2>
        <div class="resource-row">
            <span><a href="{{ path('app_admin_item_browse') }}">{{ ux_icon('item') }} {{ 'Items'|trans }} ({{ itemCount }})</a></span>
            <span class="admin-actions"><a href="{{ path('app_admin_item_add') }}">{{ ux_icon('add') }} {{ 'Add'|trans }}</a></span>
        </div>
        <div class="resource-row">
            <span><a href="{{ path('app_admin_item_set_browse') }}">{{ ux_icon('itemSet') }} {{ 'Item sets'|trans }} ({{ itemSetCount }})</a></span>
            <span class="admin-actions"><a href="{{ path('app_admin_item_set_add') }}">{{ ux_icon('add') }} {{ 'Add'|trans }}</a></span>
        </div>
        <div class="resource-row">
            <span><a href="{{ path('app_admin_vocabulary_browse') }}">{{ ux_icon('vocabulary') }} {{ 'Vocabularies'|trans }} ({{ vocabularyCount }})</a></span>
            <span class="admin-actions"><a href="{{ path('app_admin_vocabulary_import') }}">{{ ux_icon('add') }} {{ 'Import'|trans }}</a></span>
        </div>
        <div class="resource-row">
            <span><a href="{{ path('app_admin_resource_template_browse') }}">{{ ux_icon('resourceTemplate') }} {{ 'Resource templates'|trans }} ({{ resourceTemplateCount }})</a></span>
            <span class="admin-actions"><a href="{{ path('app_admin_resource_template_add') }}">{{ ux_icon('add') }} {{ 'Add'|trans }}</a></span>
        </div>
    </div>

    <div class="panel">
        <h2>{{ 'Manage sites'|trans }}</h2>
        {% for site in sites %}
            <div class="site-row">
                <span class="site-name"><a href="{{ path('app_admin_site_show', {slug: site.slug()}) }}">{{ ux_icon('site') }} {{ site.title() }}</a></span>
                <span class="admin-actions"><a class="public" href="{{ path('app_site_public', {siteSlug: site.slug()}) }}" target="_blank">{{ ux_icon('public') }} {{ 'Public'|trans }}</a></span>
            </div>
        {% else %}
            <p>{{ 'No sites found.'|trans }}</p>
        {% endfor %}
        <div class="site-row">
            <span><a href="{{ path('app_admin_site_add') }}">{{ ux_icon('add') }} {{ 'Add site'|trans }}</a></span>
        </div>
    </div>
{% endblock %}
