{% extends 'admin/base.html.twig' %}

{% block title %}{{ 'Item'|trans }}: {{ item.displayTitle() }}{% endblock %}

{% block admin_body %}
    <h1>{{ item.displayTitle() }}</h1>
    <p>{{ 'ID'|trans }}: {{ item.id() }}</p>
    <p>{{ 'Created'|trans }}: {{ item.created() ? item.created().format('Y-m-d H:i') : '' }}</p>
    <p>{{ 'Modified'|trans }}: {{ item.modified() ? item.modified().format('Y-m-d H:i') : '' }}</p>
    <p>{{ 'Public'|trans }}: {{ item.isPublic() ? 'Yes'|trans : 'No'|trans }}</p>
    <p>{{ 'Owner'|trans }}: {{ item.owner() ? item.owner().name() : '' }}</p>
    <p>{{ 'Resource class'|trans }}: {{ item.resourceClass() ? item.resourceClass().label() : '' }}</p>
    <p>{{ 'Resource template'|trans }}: {{ item.resourceTemplate() ? item.resourceTemplate().label() : '' }}</p>

    <h2>{{ 'Related resources'|trans }}</h2>
    <div>
        <h3>{{ 'Item sets'|trans }}</h3>
        {% set itemSets = item.itemSets() %}
        {% if itemSets is empty %}
            <p>{{ 'None.'|trans }}</p>
        {% else %}
            <ul>
                {% for itemSet in itemSets %}
                    <li>
                        <a href="{{ path('app_admin_item_set_show', {id: itemSet.id()}) }}">
                            {{ ux_icon('itemSet') }} {{ itemSet.displayTitle() }}
                        </a>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    </div>
    <div>
        <h3>{{ 'Sites'|trans }}</h3>
        {% set sites = item.sites() %}
        {% if sites is empty %}
            <p>{{ 'None.'|trans }}</p>
        {% else %}
            <ul>
                {% for site in sites %}
                    <li>
                        <a href="{{ path('app_admin_site_show', {slug: site.slug()}) }}">
                            {{ ux_icon('sites') }} {{ site.title() }}
                        </a>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    </div>
    <div>
        <h3>{{ 'Media'|trans }}</h3>
        {% set mediaItems = item.media() %}
        {% if mediaItems is empty %}
            <p>{{ 'None.'|trans }}</p>
        {% else %}
            <ul>
                {% for media in mediaItems %}
                    <li>
                        <a href="{{ path('app_admin_media_show', {id: media.id()}) }}">
                            {{ ux_icon('media') }} {{ media.displayTitle() }}
                        </a>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    </div>

    <h2>{{ 'Values'|trans }}</h2>
    {% set values = item.values() %}
    {% if values is empty %}
        <p>{{ 'No values.'|trans }}</p>
    {% else %}
        <dl>
            {% for term, info in values %}
                <dt>{{ info.property.label() }} ({{ term }})</dt>
                <dd>
                    {% for value in info.values %}
                        <div>{{ value.asHtml()|raw }}</div>
                    {% endfor %}
                </dd>
            {% endfor %}
        </dl>
    {% endif %}

    <div class="admin-actions">
        <a href="{{ path('app_admin_item_edit', {itemId: item.id()}) }}">{{ ux_icon('edit') }} {{ 'Edit'|trans }}</a>
        <a href="{{ path('app_admin_item_delete', {itemId: item.id()}) }}">{{ ux_icon('delete') }} {{ 'Delete'|trans }}</a>
    </div>
{% endblock %}
