{% extends 'admin/base.html.twig' %}

{% block title %}{{ 'Browse'|trans }} {{ result.resourceType }}{% endblock %}

{% block admin_body %}
    <h1>{{ result.resourceType|replace({'_': ' '})|title }}</h1>
    <p>{{ 'Total'|trans }}: {{ result.total }}</p>

    <twig:AdminBrowseTable :result="result" />

    <div class="sidebar">
        <a href="#" class="sidebar-close o-icon-close" title="{{ 'Close'|trans }}"></a>
        <div class="sidebar-content"></div>
    </div>
{% endblock %}
