{% extends 'admin/site/base.html.twig' %}

{% block title %}{{ 'Site'|trans }}: {{ site.title() }}{% endblock %}

{% block admin_body %}
    <h1>{{ site.title() }}</h1>

    <div class="meta-group">
        <p>{{ 'Slug'|trans }}: <code>{{ site.slug() }}</code></p>
        <p>{{ 'Public'|trans }}: {{ site.isPublic() ? 'Yes'|trans : 'No'|trans }}</p>
        <p>{{ 'Theme'|trans }}: {{ site.theme() }}</p>
        <p>{{ 'Owner'|trans }}: {{ site.owner() ? site.owner().name() : '' }}</p>
        <p>{{ 'Created'|trans }}: {{ site.created() ? site.created().format('Y-m-d H:i') : '' }}</p>
        {% if site.modified() %}
            <p>{{ 'Modified'|trans }}: {{ site.modified().format('Y-m-d H:i') }}</p>
        {% endif %}
    </div>

    {% if site.summary() %}
        <h2>{{ 'Summary'|trans }}</h2>
        <p>{{ site.summary() }}</p>
    {% endif %}

    <div id="page-actions">
        <a href="{{ path('app_site_show', {siteSlug: site.slug()}) }}" class="button" target="_blank">{{ ux_icon('public') }} {{ 'View public site'|trans }}</a>
        <a href="{{ path('app_admin_site_edit', {slug: site.slug()}) }}" class="button">{{ ux_icon('edit') }} {{ 'Edit'|trans }}</a>
    </div>
{% endblock %}
