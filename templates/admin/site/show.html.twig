{% extends 'admin/base.html.twig' %}

{% block title %}{{ 'Site'|trans }}: {{ site.title() }}{% endblock %}

{% block admin_body %}
    <h1>{{ site.title() }}</h1>
    <p>{{ 'ID'|trans }}: {{ site.id() }}</p>
    <p>{{ 'Slug'|trans }}: {{ site.slug() }}</p>
    <p>{{ 'Public'|trans }}: {{ site.isPublic() ? 'Yes'|trans : 'No'|trans }}</p>
    <p>{{ 'Theme'|trans }}: {{ site.theme() }}</p>
    <p>{{ 'Owner'|trans }}: {{ site.owner() ? site.owner().name() : '' }}</p>
    <p>{{ 'Created'|trans }}: {{ site.created() ? site.created().format('Y-m-d H:i') : '' }}</p>
    <p>{{ 'Modified'|trans }}: {{ site.modified() ? site.modified().format('Y-m-d H:i') : '' }}</p>

    {% if site.summary() %}
        <h2>{{ 'Summary'|trans }}</h2>
        <p>{{ site.summary() }}</p>
    {% endif %}

    <h2>{{ 'Manage'|trans }}</h2>
    <ul>
        <li><a href="{{ path('app_admin_site_pages', {slug: site.slug()}) }}">{{ ux_icon('pages') }} {{ 'Pages'|trans }}</a></li>
        <li><a href="{{ path('app_admin_site_navigation', {slug: site.slug()}) }}">{{ ux_icon('navigation') }} {{ 'Navigation'|trans }}</a></li>
        <li><a href="{{ path('app_admin_site_resources', {slug: site.slug()}) }}">{{ ux_icon('resources') }} {{ 'Resources'|trans }}</a></li>
        <li><a href="{{ path('app_admin_site_users', {slug: site.slug()}) }}">{{ ux_icon('users') }} {{ 'Users'|trans }}</a></li>
        <li><a href="{{ path('app_admin_site_theme', {slug: site.slug()}) }}">{{ ux_icon('theme') }} {{ 'Theme'|trans }}</a></li>
    </ul>

    <div class="admin-actions">
        <a href="{{ path('app_site_public', {siteSlug: site.slug()}) }}" target="_blank">{{ ux_icon('public') }} {{ 'View public site'|trans }}</a>
        <a href="{{ path('app_admin_site_edit', {slug: site.slug()}) }}">{{ ux_icon('edit') }} {{ 'Edit'|trans }}</a>
        <a href="{{ path('app_admin_site_delete', {slug: site.slug()}) }}">{{ ux_icon('delete') }} {{ 'Delete'|trans }}</a>
    </div>
{% endblock %}
