<table>
    <thead>
        <tr>
            <th>{{ 'Title'|trans }}</th>
            {% for column in result.columns %}
                <th>{{ browse_header(column) }}</th>
            {% endfor %}
            <th>{{ 'Actions'|trans }}</th>
        </tr>
    </thead>
    <tbody>
        {% for resource in result.resources %}
            <tr>
                <td>{{ browse_title(resource) }}</td>
                {% for column in result.columns %}
                    <td>{{ browse_cell(resource, column) }}</td>
                {% endfor %}
                <td class="admin-actions">
                    {% if result.resourceType == 'items' %}
                        <ul class="actions">
                            <li><a href="{{ path('app_admin_item_show', {itemId: resource.id()}) }}" title="{{ 'View'|trans }}">{{ ux_icon('view') }}</a></li>
                            <li><a href="{{ path('app_admin_item_edit', {itemId: resource.id()}) }}" title="{{ 'Edit'|trans }}">{{ ux_icon('edit') }}</a></li>
                            <li><a href="{{ path('app_admin_item_delete', {itemId: resource.id()}) }}" title="{{ 'Delete'|trans }}">{{ ux_icon('delete') }}</a></li>
                        </ul>
                    {% elseif result.resourceType == 'item_sets' %}
                        <ul class="actions">
                            <li><a href="{{ path('app_admin_item_set_show', {id: resource.id()}) }}" title="{{ 'View'|trans }}">{{ ux_icon('view') }}</a></li>
                            <li><a href="{{ path('app_admin_item_set_edit', {id: resource.id()}) }}" title="{{ 'Edit'|trans }}">{{ ux_icon('edit') }}</a></li>
                            <li><a href="{{ path('app_admin_item_set_delete', {id: resource.id()}) }}" title="{{ 'Delete'|trans }}">{{ ux_icon('delete') }}</a></li>
                        </ul>
                    {% elseif result.resourceType == 'media' %}
                        <ul class="actions">
                            <li><a href="{{ path('app_admin_media_show', {id: resource.id()}) }}" title="{{ 'View'|trans }}">{{ ux_icon('view') }}</a></li>
                            <li><a href="{{ path('app_admin_media_edit', {id: resource.id()}) }}" title="{{ 'Edit'|trans }}">{{ ux_icon('edit') }}</a></li>
                            <li><a href="{{ path('app_admin_media_delete', {id: resource.id()}) }}" title="{{ 'Delete'|trans }}">{{ ux_icon('delete') }}</a></li>
                        </ul>
                    {% elseif result.resourceType == 'vocabularies' %}
                        <ul class="actions">
                            <li><a href="{{ path('app_admin_vocabulary_show', {id: resource.id()}) }}" title="{{ 'View'|trans }}">{{ ux_icon('view') }}</a></li>
                            <li><a href="{{ path('app_admin_vocabulary_edit', {id: resource.id()}) }}" title="{{ 'Edit'|trans }}">{{ ux_icon('edit') }}</a></li>
                            <li><a href="{{ path('app_admin_vocabulary_delete', {id: resource.id()}) }}" title="{{ 'Delete'|trans }}">{{ ux_icon('delete') }}</a></li>
                        </ul>
                    {% elseif result.resourceType == 'resource_templates' %}
                        <ul class="actions">
                            <li><a href="{{ path('app_admin_resource_template_show', {id: resource.id()}) }}" title="{{ 'View'|trans }}">{{ ux_icon('view') }}</a></li>
                            <li><a href="{{ path('app_admin_resource_template_edit', {id: resource.id()}) }}" title="{{ 'Edit'|trans }}">{{ ux_icon('edit') }}</a></li>
                            <li><a href="{{ path('app_admin_resource_template_delete', {id: resource.id()}) }}" title="{{ 'Delete'|trans }}">{{ ux_icon('delete') }}</a></li>
                        </ul>
                    {% elseif result.resourceType == 'users' %}
                        <ul class="actions">
                            <li><a href="{{ path('app_admin_user_show', {id: resource.id()}) }}" title="{{ 'View'|trans }}">{{ ux_icon('view') }}</a></li>
                            <li><a href="{{ path('app_admin_user_edit', {id: resource.id()}) }}" title="{{ 'Edit'|trans }}">{{ ux_icon('edit') }}</a></li>
                            <li><a href="{{ path('app_admin_user_delete', {id: resource.id()}) }}" title="{{ 'Delete'|trans }}">{{ ux_icon('delete') }}</a></li>
                        </ul>
                    {% elseif result.resourceType == 'sites' %}
                        <ul class="actions">
                            <li><a href="{{ path('app_admin_site_show', {slug: resource.slug()}) }}" title="{{ 'View'|trans }}">{{ ux_icon('view') }}</a></li>
                            <li><a href="{{ path('app_admin_site_edit', {slug: resource.slug()}) }}" title="{{ 'Edit'|trans }}">{{ ux_icon('edit') }}</a></li>
                            <li><a href="{{ path('app_admin_site_delete', {slug: resource.slug()}) }}" title="{{ 'Delete'|trans }}">{{ ux_icon('delete') }}</a></li>
                        </ul>
                    {% else %}
                        <a href="#" title="{{ 'View'|trans }}">{{ ux_icon('view') }}</a>
                    {% endif %}
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="{{ result.columns|length + 2 }}">{{ 'No results.'|trans }}</td>
            </tr>
        {% endfor %}
    </tbody>
</table>
