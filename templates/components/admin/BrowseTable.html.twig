<table>
    <thead>
        <tr>
            <th>{{ 'Title'|trans }}</th>
            {% for column in result.columns %}
                <th>{{ browse_header(column) }}</th>
            {% endfor %}
            <th>{{ 'Actions'|trans }}</th>
        </tr>
    </thead>
    <tbody>
        {% for resource in result.resources %}
            <tr>
                <td>{{ browse_title(resource) }}</td>
                {% for column in result.columns %}
                    <td>{{ browse_cell(resource, column) }}</td>
                {% endfor %}
                <td class="admin-actions">
                    {% if result.resourceType == 'items' %}
                        <ul class="actions">
                            <li>
                                <a class="sidebar-content" href="#"
                                   data-sidebar-selector=".admin-main .sidebar"
                                   data-sidebar-content-url="{{ path('app_legacy_proxy', {routeName: 'admin/id', controller: 'item', action: 'show-details', id: resource.id()}) }}"
                                   title="{{ 'Details'|trans }}">{{ ux_icon('view') }}</a>
                            </li>
                            <li>
                                <a href="{{ path('app_admin_item_edit', {itemId: resource.id()}) }}" title="{{ 'Edit'|trans }}">{{ ux_icon('edit') }}</a>
                            </li>
                            <li>
                                <a class="sidebar-content" href="#"
                                   data-sidebar-selector=".admin-main .sidebar"
                                   data-sidebar-content-url="{{ path('app_legacy_proxy', {routeName: 'admin/id', controller: 'item', action: 'delete-confirm', id: resource.id()}) }}"
                                   title="{{ 'Delete'|trans }}">{{ ux_icon('delete') }}</a>
                            </li>
                        </ul>
                    {% elseif result.resourceType in ['item_sets', 'media', 'resource_templates', 'vocabularies'] %}
                        {% set controller = {
                            'item_sets': 'item-set',
                            'resource_templates': 'resource-template',
                            'vocabularies': 'vocabulary'
                        }[result.resourceType]|default(result.resourceType|slice(0, -1)) %}
                        <ul class="actions">
                            <li>
                                <a class="sidebar-content" href="#"
                                   data-sidebar-selector=".admin-main .sidebar"
                                   data-sidebar-content-url="{{ path('app_legacy_proxy', {routeName: 'admin/id', controller: controller, action: 'show-details', id: resource.id()}) }}"
                                   title="{{ 'Details'|trans }}">{{ ux_icon('view') }}</a>
                            </li>
                            <li>
                                <a href="{{ path('app_legacy_proxy', {routeName: 'admin/id', controller: controller, id: resource.id(), action: 'edit'}) }}" title="{{ 'Edit'|trans }}">{{ ux_icon('edit') }}</a>
                            </li>
                            <li>
                                <a class="sidebar-content" href="#"
                                   data-sidebar-selector=".admin-main .sidebar"
                                   data-sidebar-content-url="{{ path('app_legacy_proxy', {routeName: 'admin/id', controller: controller, action: 'delete-confirm', id: resource.id()}) }}"
                                   title="{{ 'Delete'|trans }}">{{ ux_icon('delete') }}</a>
                            </li>
                        </ul>
                    {% elseif result.resourceType == 'sites' %}
                        <ul class="actions">
                            <li>
                                <a class="sidebar-content" href="#"
                                   data-sidebar-selector=".admin-main .sidebar"
                                   data-sidebar-content-url="{{ path('app_legacy_proxy', {routeName: 'admin/site/slug/action', 'site-slug': resource.slug(), action: 'show-details'}) }}"
                                   title="{{ 'Details'|trans }}">{{ ux_icon('view') }}</a>
                            </li>
                            <li>
                                <a href="{{ path('app_legacy_proxy', {routeName: 'admin/site/slug/action', 'site-slug': resource.slug(), action: 'edit'}) }}" title="{{ 'Edit'|trans }}">{{ ux_icon('edit') }}</a>
                            </li>
                            <li>
                                <a class="sidebar-content" href="#"
                                   data-sidebar-selector=".admin-main .sidebar"
                                   data-sidebar-content-url="{{ path('app_legacy_proxy', {routeName: 'admin/site/slug/action', 'site-slug': resource.slug(), action: 'delete-confirm'}) }}"
                                   title="{{ 'Delete'|trans }}">{{ ux_icon('delete') }}</a>
                            </li>
                        </ul>
                    {% else %}
                        <a href="#" title="{{ 'View'|trans }}">{{ ux_icon('view') }}</a>
                    {% endif %}
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="{{ result.columns|length + 2 }}">{{ 'No results.'|trans }}</td>
            </tr>
        {% endfor %}
    </tbody>
</table>
