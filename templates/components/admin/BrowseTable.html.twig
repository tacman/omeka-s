<table>
    <thead>
        <tr>
            <th>Title</th>
            {% for column in result.columns %}
                <th>{{ browse_header(column) }}</th>
            {% endfor %}
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
            {% for resource in result.resources %}
                <tr>
                <td>{{ browse_title(resource) }}</td>
                {% for column in result.columns %}
                    <td>{{ browse_cell(resource, column) }}</td>
                {% endfor %}
                <td class="admin-actions">
                    {% if result.resourceType == 'items' %}
                        <a href="{{ path('app_admin_item_show', {itemId: resource.id()}) }}" title="View">{{ ux_icon('view') }}</a>
                        <a href="{{ path('app_admin_item_edit', {itemId: resource.id()}) }}" title="Edit">{{ ux_icon('edit') }}</a>
                        <a href="{{ path('app_admin_item_delete', {itemId: resource.id()}) }}" title="Delete">{{ ux_icon('delete') }}</a>
                    {% else %}
                        <a href="#" title="View">{{ ux_icon('view') }}</a>
                    {% endif %}
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="{{ result.columns|length + 2 }}">No results.</td>
            </tr>
        {% endfor %}
    </tbody>
</table>
