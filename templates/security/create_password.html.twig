{% extends 'base.html.twig' %}

{% block title %}Create Password{% endblock %}

{% block body %}
<div style="max-width: 400px; margin: 3rem auto;">
    <h1>Create Password</h1>
    <form method="post">
        <div style="margin-bottom: 1rem;">
            <label for="password">New Password</label><br>
            <input type="password" id="password" name="password" required style="width: 100%; padding: 0.4rem;">
        </div>
        <div style="margin-bottom: 1rem;">
            <label for="password_confirm">Confirm Password</label><br>
            <input type="password" id="password_confirm" name="password_confirm" required style="width: 100%; padding: 0.4rem;">
        </div>
        <button type="submit" style="padding: 0.5rem 1.5rem;">Set Password</button>
    </form>
</div>
{% endblock %}
