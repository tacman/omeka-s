{% extends 'base.html.twig' %}

{% block title %}Item Sets · {{ site.title() }}{% endblock %}

{% block body %}
<div class="site-content">
    <p><a href="{{ path('app_site_show', {siteSlug: siteSlug}) }}">&larr; {{ site.title() }}</a></p>

    <h1>Item Sets</h1>

    {% if totalResults is defined %}
        <p>{{ totalResults }} result{{ totalResults != 1 ? 's' : '' }}</p>
    {% endif %}

    {% if itemSets is empty %}
        <p>No item sets found.</p>
    {% else %}
        <div class="resources">
            {% for itemSet in itemSets %}
                <div class="resource" style="margin-bottom: 1.5rem; padding-bottom: 1rem; border-bottom: 1px solid #eee;">
                    {% set thumbnail = itemSet.thumbnailDisplayUrl('medium') %}
                    {% if thumbnail %}
                        <a href="{{ path('app_site_item_set_items', {siteSlug: siteSlug, itemSetId: itemSet.id()}) }}" style="float: left; margin-right: 1rem;">
                            <img src="{{ thumbnail }}" alt="" style="max-width: 100px; max-height: 100px;">
                        </a>
                    {% endif %}
                    <h3 style="margin: 0 0 0.25rem;">
                        <a href="{{ path('app_site_item_set_items', {siteSlug: siteSlug, itemSetId: itemSet.id()}) }}">
                            {{ itemSet.displayTitle() }}
                        </a>
                    </h3>
                    {% set description = itemSet.displayDescription() %}
                    {% if description %}
                        <p style="margin: 0; color: #555;">{{ description|striptags|slice(0, 200) }}{% if description|length > 200 %}&hellip;{% endif %}</p>
                    {% endif %}
                    <div style="clear: both;"></div>
                </div>
            {% endfor %}
        </div>
    {% endif %}
</div>
{% endblock %}
