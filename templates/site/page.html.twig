{% extends 'base.html.twig' %}

{% block title %}{{ page.title() }} · {{ site.title() }}{% endblock %}

{% block body %}
<div>
    <p><a href="{{ path('app_site_public', {siteSlug: site.slug()}) }}">Back to {{ site.title() }}</a></p>
    <h1>{{ page.title() }}</h1>

    {% for block in page.blocks() %}
        {% if block.layout() == 'html' %}
            <div class="page-block page-block-html">{{ block.dataValue('html')|raw }}</div>
        {% endif %}
    {% endfor %}
</div>
{% endblock %}
